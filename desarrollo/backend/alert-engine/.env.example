# Puerto (Heroku lo inyecta automáticamente)
PORT=3001

# MongoDB (Atlas o local). Si se omite, el servicio corre sin persistencia.
MONGODB_URI=mongodb://localhost:27017/quakealert

# Bus de eventos RabbitMQ (CloudAMQP). Si se omite, los eventos se loguean en consola.
AMQP_URL=

# Header para multi-tenant
TENANT_HEADER=x-tenant-id
